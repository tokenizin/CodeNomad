{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "../../../..",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "../ui/src/types/session.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/__tests__"
  ]
}