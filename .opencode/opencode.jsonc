{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.8:27b",
  "instructions": [
    "../AGENTS.md",
    "agent/codenomad_agent_runner.md"
  ],
  "plugin": [],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:latest": {
          "id": "gemma4:latest",
          "name": "Gemma 4 8B (local)",
          "tool_call": true,
          "reasoning": true
        },
        "gemma4:26b": {
          "id": "gemma4:26b",
          "name": "Gemma 4 26B (local · vision/creative_3d · 262K · multimodal)",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 262144,
            "output": 262144,
            "input": 262144
          }
        },
        "qwen3.8:27b": {
          "id": "qwen3.8:27b",
          "name": "Qwen 3.8 27B (local · code/text/orchestration · 262K)",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 262144,
            "output": 262144,
            "input": 262144
          }
        },
        "hermes3:latest": {
          "id": "hermes3:latest",
          "name": "Hermes 3 8B (local)",
          "tool_call": true
        },
        "llama3.2:latest": {
          "id": "llama3.2:latest",
          "name": "Llama 3.2 3B (local)",
          "tool_call": true
        },
        "glm-ocr:latest": {
          "id": "glm-ocr:latest",
          "name": "GLM OCR 1.1B (local, vision)",
          "tool_call": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "tokenizin/concierge-web2.5:latest": {
          "id": "tokenizin/concierge-web2.5:latest",
          "name": "TokiDAPP Concierge 3.2B (local)",
          "tool_call": true
        },
        "minimax-m2.7:cloud": {
          "id": "minimax-m2.7:cloud",
          "name": "MiniMax M2.7 (Ollama cloud)",
          "tool_call": true,
          "reasoning": true
        },
        "muse-glimmer:30b-q4_K_M-pinned": {
          "id": "muse-glimmer:30b-q4_K_M-pinned",
          "name": "Muse Glimmer 30B Q4_K_M (pinned)",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen3-vl:235b-a22b-thinking-bf16-pinned": {
          "id": "qwen3-vl:235b-a22b-thinking-bf16-pinned",
          "name": "Qwen3 VL 235B A22B Thinking (pinned)",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen3.6:latest": {
          "id": "qwen3.6:latest",
          "name": "Qwen 3.6 (36B MoE, coding fallback)",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen3.8-flash-next:125b-a6b-q4_K_M": {
          "id": "qwen3.8-flash-next:125b-a6b-q4_K_M",
          "name": "Qwen3.8 Flash Next 125B A6B Q4_K_M (local)",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "ornith:latest": {
          "id": "ornith:latest",
          "name": "Ornith 1.0 (vision fallback)",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM (GLM-5.3-Flash default)",
      "apiKey": "{env:NVIDIA_API_KEY}",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "z-ai/glm-5.3-flash": {
          "id": "z-ai/glm-5.3-flash",
          "name": "GLM-5.3-Flash (z.ai · NVIDIA NIM)",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 262144,
            "output": 65536
          }
        }
      }
    },
    "openrouter-fallback": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GLM-5.3-Flash (NIM) → Ollama qwen3.6 → Zen fallback (shim :11436)",
      "options": {
        "baseURL": "http://127.0.0.1:11436/v1"
      },
      "apiKey": "ollama",
      "models": {
        "auto": {
          "id": "auto",
          "name": "GLM-5.3-Flash (NIM) with automatic Qwen 3.6 / Zen fallback",
          "tool_call": true,
          "reasoning": true,
          "attachment": false,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    },
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go (MiMo V2.5)",
      "apiKey": "${OPENCODE_GO_API_KEY:-ollama}",
      "options": {
        "baseURL": "https://opencode.ai/zen/go"
      },
      "models": {
        "mimo-v2.5": {
          "id": "mimo-v2.5",
          "name": "MiMo V2.5",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "context": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    },
    "nous": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nous Research",
      "apiKey": "${NOUS_API_KEY}",
      "options": {
        "baseURL": "https://inference-api.nousresearch.com/v1"
      },
      "models": {
        "meituan/longcat-2.0:free": {
          "id": "meituan/longcat-2.0:free",
          "name": "LongCat 2.0 (free)",
          "tool_call": true,
          "reasoning": false,
          "attachment": false
        }
      }
    }
  },
  "agent": {
    "opencoder": {
      "description": "Orchestration agent for complex coding, architecture, and multi-file refactoring with approval gates",
      "mode": "primary",
      "prompt": "{file:../../.opencode/agents/opencoder.md}"
    },
    "openagent": {
      "description": "Universal agent for answering queries, executing tasks, and coordinating workflows across any domain",
      "mode": "primary",
      "prompt": "{file:../../.opencode/agents/openagent.md}"
    },
    "eval-runner": {
      "description": "Runs evaluations and test suites against project benchmarks",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/eval-runner.md}"
    },
    "copywriter": {
      "description": "Content creation and marketing copy specialist",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/copywriter.md}"
    },
    "technical-writer": {
      "description": "Technical documentation and API reference writer",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/technical-writer.md}"
    },
    "data-analyst": {
      "description": "Data analysis, visualization, and insight generation",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/data-analyst.md}"
    },
    "solidity-architect": {
      "description": "Expert-level Solidity & EVM Blockchain Architect. Absolute domain authority for smart contract design, OpenZeppelin libraries, upgradeable patterns, ERC-4337 AA, and security review.",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/solidity-architect.md}"
    },
    "ceo": {
      "description": "Chief Executive Officer \u2014 ecosystem vision, risk management, resource allocation, strategic decisions",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/ceo.md}"
    },
    "cto": {
      "description": "Chief Technology Officer \u2014 technology strategy, architecture decisions, technical risk, infrastructure",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/cto.md}"
    },
    "cmo": {
      "description": "Chief Marketing Officer \u2014 brand strategy, campaign execution, dApp UI governance, community growth",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/cmo.md}"
    },
    "cso": {
      "description": "Chief Security Officer \u2014 smart contract audit governance, incident response, threat modeling, security review gates",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/cso.md}"
    },
    "cfo": {
      "description": "Chief Financial Officer \u2014 treasury management, tokenomics, budget allocation, investor reporting, financial risk",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/cfo.md}"
    },
    "cao": {
      "description": "Chief Acquisition Officer \u2014 merchant acquisition, venue onboarding, Prestix.vip partnership, consumer growth, and strategic partnerships",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/cao.md}"
    },
    "coo": {
      "description": "Chief Operating Officer \u2014 process optimization, infrastructure operations, release management, cross-team coordination, and incident response",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/coo.md}"
    },
    "product_manager": {
      "description": "Product Manager Agent (PMA) \u2014 central orchestrator for all NomadWorks agent activities, task assignment, and workflow management",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/product_manager.md}"
    },
    "business_analyst": {
      "description": "Business Analyst \u2014 document steward, requirements analyst, translates product goals into specifications",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/business_analyst.md}"
    },
    "tech_lead": {
      "description": "Tech Lead \u2014 leads technical development, ensures code quality, architectural adherence, and functional verification",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/tech_lead.md}"
    },
    "technical_architect": {
      "description": "Technical Architect \u2014 defines technical interfaces, architectural patterns, and ensures technical consistency",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/technical_architect.md}"
    },
    "developer": {
      "description": "Developer \u2014 implements features and writes tests according to architectural designs",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/developer.md}"
    },
    "qa_engineer": {
      "description": "QA Engineer \u2014 designs, develops, and executes automated test suites, verifies manual scripts",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/qa_engineer.md}"
    },
    "ui_ux_designer": {
      "description": "UI/UX Designer \u2014 god-mode design authority with systemic thinking, heuristic evaluation, neuro-inclusive accessibility, dark pattern audits, and award-winning visual review",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/ui_ux_designer.md}"
    },
    "mui_engineer": {
      "description": "MUI Engineer \u2014 expert MUI component developer, produces production-ready Material-UI components, design critiques, Storybook stories, and Jest tests with accessibility enforcement",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/mui_engineer.md}"
    },
    "workflow_runner": {
      "description": "Workflow Runner \u2014 delegated workflow executor for PMA-started task lifecycles, including implementation, verification, and finalization",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/workflow_runner.md}"
    },
    "infra_sme": {
      "model": "opencode-go/mimo-v2.5",
      "description": "Infrastructure SME \u2014 platform topology, CI/CD design, schema migration strategy, release architecture, automation patterns, incident triage, multi-regional scalability, multi-software lifecycle, performance optimization, and FinOps cost efficiency advisory",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/infra_sme.md}",
      "mcp": [
        "chrome-devtools"
      ]
    },
    "dev_ops": {
      "model": "opencode-go/mimo-v2.5",
      "description": "DevOps \u2014 CI/CD, Vercel deploys, schema push and seeds, release versioning, code revision & quality gates, testing pipeline (vitest/hardhat/playwright), packaging (next build/solidity/CodeNomad/Docker), hosting & deploying (Vercel multi-region/CodeNomad tunnel/contract deploy), publishing, schema ops, multi-software automation, performance optimization, and FinOps cost efficiency",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/dev_ops.md}",
      "mcp": [
        "chrome-devtools"
      ]
    },
    "contract_security_auditor": {
      "description": "Contract Security Auditor \u2014 smart contract vulnerability assessment, risk analysis, and security verification",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/contract_security_auditor.md}"
    },
    "evm_optimization_engineer": {
      "description": "EVM Optimization Engineer \u2014 gas optimization, contract efficiency, deployment cost reduction",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/evm_optimization_engineer.md}"
    },
    "upgrade_specialist": {
      "description": "Upgrade Specialist \u2014 upgradeable smart contract architecture, storage layout compatibility, proxy safety",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/upgrade_specialist.md}"
    },
    "codenomad_agent_runner": {
      "description": "CodeNomad codenomad agent runner",
      "mode": "primary",
      "prompt": "{file:agent/codenomad_agent_runner.md}"
    },
    "web_developer": {
      "description": "CodeNomad web developer",
      "mode": "primary",
      "prompt": "{file:agent/web_developer.md}"
    },
    "context-scout": {
      "description": "Discovers all relevant context files for a given domain",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/contextscout.md}"
    },
    "external-scout": {
      "description": "Fetches live documentation from external sources",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/externalscout.md}"
    },
    "task-manager": {
      "description": "Breaks phases into atomic JSON subtasks with dependencies",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/task-manager.md}"
    },
    "coder-agent": {
      "description": "Individual file implementation agent \u2014 precise, scoped code changes",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/coder-agent.md}"
    },
    "batch-executor": {
      "description": "Manages 4+ parallel CoderAgents simultaneously",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/batch-executor.md}"
    },
    "build-agent": {
      "description": "Runs type-check, lint, and production build on modified files",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/build-agent.md}"
    },
    "test-engineer": {
      "description": "Writes new Vitest tests for components, hooks, and utilities",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/test-engineer.md}"
    },
    "code-reviewer": {
      "description": "Reviews code against ALL project standards",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/reviewer.md}"
    },
    "frontend-specialist": {
      "description": "Mobile UI/UX design review \u2014 Apple HIG + MD3 compliance, touch targets, dark mode",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/frontend-specialist.md}"
    },
    "devops-specialist": {
      "description": "Vercel deployment compatibility review",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/devops-specialist.md}"
    }
  }
}