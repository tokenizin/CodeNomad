{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/gemma4:latest",
  "instructions": [
    "../AGENTS.md",
    "agent/codenomad_agent_runner.md"
  ],
  "plugin": [],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:latest": {
          "id": "gemma4:latest",
          "name": "Gemma 4 8B (local)",
          "tool_call": true,
          "reasoning": true
        },
        "hermes3:latest": {
          "id": "hermes3:latest",
          "name": "Hermes 3 8B (local)",
          "tool_call": true
        },
        "llama3.2:latest": {
          "id": "llama3.2:latest",
          "name": "Llama 3.2 3B (local)",
          "tool_call": true
        },
        "glm-ocr:latest": {
          "id": "glm-ocr:latest",
          "name": "GLM OCR 1.1B (local, vision)",
          "tool_call": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "tokenizin/concierge-web2.5:latest": {
          "id": "tokenizin/concierge-web2.5:latest",
          "name": "TokiDAPP Concierge 3.2B (local)",
          "tool_call": true
        },
        "minimax-m2.7:cloud": {
          "id": "minimax-m2.7:cloud",
          "name": "MiniMax M2.7 (Ollama cloud)",
          "tool_call": true,
          "reasoning": true
        }
      }
    }
  },
  "agent": {
    "opencoder": {
      "description": "Orchestration agent for complex coding, architecture, and multi-file refactoring with approval gates",
      "mode": "primary",
      "prompt": "{file:../../.opencode/agents/opencoder.md}"
    },
    "openagent": {
      "description": "Universal agent for answering queries, executing tasks, and coordinating workflows across any domain",
      "mode": "primary",
      "prompt": "{file:../../.opencode/agents/openagent.md}"
    },
    "eval-runner": {
      "description": "Runs evaluations and test suites against project benchmarks",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/eval-runner.md}"
    },
    "copywriter": {
      "description": "Content creation and marketing copy specialist",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/copywriter.md}"
    },
    "technical-writer": {
      "description": "Technical documentation and API reference writer",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/technical-writer.md}"
    },
    "data-analyst": {
      "description": "Data analysis, visualization, and insight generation",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/data-analyst.md}"
    },
    "solidity-architect": {
      "description": "Expert-level Solidity & EVM Blockchain Architect. Absolute domain authority for smart contract design, OpenZeppelin libraries, upgradeable patterns, ERC-4337 AA, and security review.",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/solidity-architect.md}"
    },
    "ceo": {
      "description": "Chief Executive Officer — ecosystem vision, risk management, resource allocation, strategic decisions",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/ceo.md}"
    },
    "cto": {
      "description": "Chief Technology Officer — technology strategy, architecture decisions, technical risk, infrastructure",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/cto.md}"
    },
    "cmo": {
      "description": "Chief Marketing Officer — brand strategy, campaign execution, dApp UI governance, community growth",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/cmo.md}"
    },
    "cso": {
      "description": "Chief Security Officer — smart contract audit governance, incident response, threat modeling, security review gates",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/cso.md}"
    },
    "cfo": {
      "description": "Chief Financial Officer — treasury management, tokenomics, budget allocation, investor reporting, financial risk",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/cfo.md}"
    },
    "cao": {
      "description": "Chief Acquisition Officer — merchant acquisition, venue onboarding, Prestix.vip partnership, consumer growth, and strategic partnerships",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/cao.md}"
    },
    "coo": {
      "description": "Chief Operating Officer — process optimization, infrastructure operations, release management, cross-team coordination, and incident response",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/coo.md}"
    },
    "product_manager": {
      "description": "Product Manager Agent (PMA) — central orchestrator for all NomadWorks agent activities, task assignment, and workflow management",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/product_manager.md}"
    },
    "business_analyst": {
      "description": "Business Analyst — document steward, requirements analyst, translates product goals into specifications",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/business_analyst.md}"
    },
    "tech_lead": {
      "description": "Tech Lead — leads technical development, ensures code quality, architectural adherence, and functional verification",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/tech_lead.md}"
    },
    "technical_architect": {
      "description": "Technical Architect — defines technical interfaces, architectural patterns, and ensures technical consistency",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/technical_architect.md}"
    },
    "developer": {
      "description": "Developer — implements features and writes tests according to architectural designs",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/developer.md}"
    },
    "qa_engineer": {
      "description": "QA Engineer — designs, develops, and executes automated test suites, verifies manual scripts",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/qa_engineer.md}"
    },
    "ui_ux_designer": {
      "description": "UI/UX Designer — god-mode design authority with systemic thinking, heuristic evaluation, neuro-inclusive accessibility, dark pattern audits, and award-winning visual review",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/ui_ux_designer.md}"
    },
    "mui_engineer": {
      "description": "MUI Engineer — expert MUI component developer, produces production-ready Material-UI components, design critiques, Storybook stories, and Jest tests with accessibility enforcement",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/mui_engineer.md}"
    },
    "workflow_runner": {
      "description": "Workflow Runner — delegated workflow executor for PMA-started task lifecycles, including implementation, verification, and finalization",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/workflow_runner.md}"
    },
    "infra_sme": {
      "model": "ollama/qwen2.5:14b",
      "description": "Infrastructure SME — platform topology, CI/CD design, schema migration strategy, release architecture, automation patterns, incident triage, multi-regional scalability, multi-software lifecycle, performance optimization, and FinOps cost efficiency advisory",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/infra_sme.md}",
      "mcp": ["chrome-devtools"]
    },
    "dev_ops": {
      "model": "ollama/qwen2.5:14b",
      "description": "DevOps — CI/CD, Vercel deploys, schema push and seeds, release versioning, code revision & quality gates, testing pipeline (vitest/hardhat/playwright), packaging (next build/solidity/CodeNomad/Docker), hosting & deploying (Vercel multi-region/CodeNomad tunnel/contract deploy), publishing, schema ops, multi-software automation, performance optimization, and FinOps cost efficiency",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/dev_ops.md}",
      "mcp": ["chrome-devtools"]
    },
    "cloudflare-tunnel-setup": {
      "description": "Cloudflare Tunnel Setup Wizard — interactive Q&A-guided bidirectional tunnel configuration for CodeNomad, matching the verified production tunnel setup",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/cloudflare-tunnel-setup.md}"
    },
    "contract_security_auditor": {
      "description": "Contract Security Auditor — smart contract vulnerability assessment, risk analysis, and security verification",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/contract_security_auditor.md}"
    },
    "evm_optimization_engineer": {
      "description": "EVM Optimization Engineer — gas optimization, contract efficiency, deployment cost reduction",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/evm_optimization_engineer.md}"
    },
    "upgrade_specialist": {
      "description": "Upgrade Specialist — upgradeable smart contract architecture, storage layout compatibility, proxy safety",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/upgrade_specialist.md}"
    },
    "patternfly-ux-investigator": {
      "description": "PatternFly UX Investigator — orchestrates UX SOP audits against PatternFly design system, dispatches 6 subagents across component compliance, a11y, cross-device, UX psychology, content design, and journey flow",
      "mode": "primary",
      "prompt": "{file:../../.nomadworks/agents/patternfly-ux-investigator.md}"
    },
    "patternfly-component-auditor": {
      "description": "PatternFly Component Auditor — audits UI implementations against PatternFly component standards: correct component choice, variants, states, modifiers, tokens, and deprecation awareness",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/patternfly-component-auditor.md}"
    },
    "patternfly-a11y-auditor": {
      "description": "PatternFly Accessibility Auditor — audits UI against WCAG 2.0 AA and PatternFly inclusive design standards: keyboard, focus, ARIA, contrast, screen readers, zoom, reduced motion",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/patternfly-a11y-auditor.md}"
    },
    "patternfly-device-auditor": {
      "description": "PatternFly Cross-Device Auditor — audits UI across viewports, input methods, themes, and display preferences: responsive breakpoints, touch, RTL, dark/high-contrast, print, zoom",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/patternfly-device-auditor.md}"
    },
    "patternfly-psych-auditor": {
      "description": "PatternFly UX Psychology Auditor — audits UI against cognitive psychology and UX principles: progressive disclosure, cognitive load, motion design, decision architecture, error prevention",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/patternfly-psych-auditor.md}"
    },
    "patternfly-content-auditor": {
      "description": "PatternFly Content Design Auditor — audits UI copy against PatternFly content standards: brand voice, error messages, tooltips, terminology, grammar, capitalization, localization readiness",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/patternfly-content-auditor.md}"
    },
    "patternfly-journey-auditor": {
      "description": "PatternFly Journey Flow Auditor — audits end-to-end user flows for coherence: goal achievement, step necessity, dead-ends, back nav, state preservation, permission gates, error recovery, timeout handling",
      "mode": "subagent",
      "prompt": "{file:../../.nomadworks/agents/patternfly-journey-auditor.md}"
    },
    "codenomad_agent_runner": {
      "description": "CodeNomad codenomad agent runner",
      "mode": "primary",
      "prompt": "{file:agent/codenomad_agent_runner.md}"
    },
    "web_developer": {
      "description": "CodeNomad web developer",
      "mode": "primary",
      "prompt": "{file:agent/web_developer.md}"
    },
    "context-scout": {
      "description": "Discovers all relevant context files for a given domain",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/contextscout.md}"
    },
    "external-scout": {
      "description": "Fetches live documentation from external sources",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/externalscout.md}"
    },
    "task-manager": {
      "description": "Breaks phases into atomic JSON subtasks with dependencies",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/task-manager.md}"
    },
    "coder-agent": {
      "description": "Individual file implementation agent — precise, scoped code changes",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/coder-agent.md}"
    },
    "batch-executor": {
      "description": "Manages 4+ parallel CoderAgents simultaneously",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/batch-executor.md}"
    },
    "build-agent": {
      "description": "Runs type-check, lint, and production build on modified files",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/build-agent.md}"
    },
    "test-engineer": {
      "description": "Writes new Vitest tests for components, hooks, and utilities",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/test-engineer.md}"
    },
    "code-reviewer": {
      "description": "Reviews code against ALL project standards",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/reviewer.md}"
    },
    "frontend-specialist": {
      "description": "Mobile UI/UX design review — Apple HIG + MD3 compliance, touch targets, dark mode",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/frontend-specialist.md}"
    },
    "devops-specialist": {
      "description": "Vercel deployment compatibility review",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/devops-specialist.md}"
    },
    "doc-writer": {
      "description": "Generates migration patterns docs, knowledge base entries, architecture guides",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/doc-writer.md}"
    },
    "animation-expert": {
      "description": "framer-motion page transitions, gesture feedback, stagger list animations",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/animation-expert.md}"
    },
    "mobile-qa-auditor": {
      "description": "Validates 48px touch targets, dead hover states, dark mode, mobile compliance",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/mobile-qa-auditor.md}"
    },
    "smart-account-wallet": {
      "description": "Reown AppKit smart account wallet operations — sendCalls, EIP-5792, CAIP resolution",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/smart-account-wallet.md}"
    },
    "db-admin": {
      "description": "Database operations — schema management, migrations, seeding, health checks",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/db-admin.md}"
    },
    "security-auditor": {
      "description": "Read-only security audit agent for vulnerability scanning and code review",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/security-auditor.md}"
    },
    "blockchain-debug": {
      "description": "Wallet connection, chain ID resolution, AppKit troubleshooting, wagmi debugging",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/blockchain-debug.md}"
    },
    "siwe-auth": {
      "description": "SIWE authentication implementation, debugging, and modification with Reown AppKit",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/siwe-auth.md}"
    },
    "knowledge-sync": {
      "description": "Synchronizes knowledge base artifacts across OpenCode, Cursor, and Claude ecosystems",
      "mode": "subagent",
      "prompt": "{file:../../.opencode/agents/knowledge-sync.md}"
    },
    "mobile-migration-commander": {
      "description": "Orchestrator for mobile-first hub migration — coordinates parallel agent execution, enforces standards, validates deliverables",
      "mode": "primary",
      "color": "#6366f1",
      "prompt": "{file:../../prestix.app-1/.opencode/agent/core/mobile-migration-commander.md}"
    },
    "hub-navigation": {
      "description": "Hub navigation catalog — nav entries, DB overrides, AI code generation, translation sync",
      "mode": "subagent",
      "prompt": "{file:../../prestix.app-1/.opencode/agent/hub-navigation.md}"
    },
    "security-groups": {
      "description": "Security group management for navigation permission gating and access enforcement",
      "mode": "subagent",
      "prompt": "{file:../../prestix.app-1/.opencode/agent/security-groups.md}"
    },
    "ptix": {
      "description": "PTIX token system — smart contracts, bonding curve, commission exchange, claims",
      "mode": "subagent",
      "color": "#8b5cf6",
      "prompt": "{file:../../prestix.app-1/.opencode/agent/ptix.md}"
    },
    "blog-fundraising-ds": {
      "description": "Registers blog fundraising on Sepolia DynamicSplitter — payout wallet, split config, on-chain verify",
      "mode": "subagent",
      "prompt": "{file:../../prestix.app-1/.opencode/agent/blog-fundraising-ds.md}"
    },
    "partner-agreement": {
      "description": "Partner agreement lifecycle — submission, review, EIP-191 signing, payment, revenue share",
      "mode": "subagent",
      "prompt": "{file:../../prestix.app-1/.opencode/agent/partner-agreement.md}"
    },
    "mobile-migration-animation": {
      "description": "Animation & transition expert — framer-motion page transitions, gesture feedback, micro-interactions",
      "mode": "subagent",
      "prompt": "{file:../../prestix.app-1/.opencode/agent/mobile-migration-animation.md}"
    },
    "mobile-migration-form-wizard": {
      "description": "Form & wizard optimizer — multi-step to single-task-per-screen mobile flows",
      "mode": "subagent",
      "prompt": "{file:../../prestix.app-1/.opencode/agent/mobile-migration-form-wizard.md}"
    },
    "mobile-migration-layout-nav": {
      "description": "Mobile layout & navigation — desktop shells to BottomNavigation, SwipeableDrawers",
      "mode": "subagent",
      "prompt": "{file:../../prestix.app-1/.opencode/agent/mobile-migration-layout-nav.md}"
    },
    "mobile-migration-qa-test": {
      "description": "Mobile QA & test auditor — 48px touch targets, dead hover states, Playwright mobile emulation",
      "mode": "subagent",
      "prompt": "{file:../../prestix.app-1/.opencode/agent/mobile-migration-qa-test.md}"
    },
    "mobile-migration-table-grid": {
      "description": "Table & grid converter — data table rows to card stacks, multi-column to vertical stacks",
      "mode": "subagent",
      "prompt": "{file:../../prestix.app-1/.opencode/agent/mobile-migration-table-grid.md}"
    }
  }
}
