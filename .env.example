# ── NomadWorks PMA Voice Engine ───────────────────────────────────────
# Composite voice adapter: STT -> LLM -> TTS with pluggable provider.
# VOICE_PMA_LLM_PROVIDER=openai   # "openai" or "grok"
# VOICE_PMA_OPENAI_MODEL=gpt-4o-mini
# VOICE_PMA_GROK_MODEL=grok-2-latest
# VOICE_PMA_STT_ENGINE=openai-whisper
# VOICE_PMA_TTS_ENGINE=openai-tts
# VOICE_PMA_LATENCY_FALLBACK_MS=500
# XAI_API_KEY=                     # required when VOICE_PMA_LLM_PROVIDER=grok
# XAI_BASE_URL=https://api.x.ai/v1  # shared with generic grok provider in model-providers.ts
